+/* ===== Per-question countdown v3 ===== */
+.question-timer-pill{
+  min-width:112px;
+  font-variant-numeric:tabular-nums;
+  border-color:rgba(99,218,255,.34)!important;
+  transition:.18s ease;
+}
+.question-timer-pill b{
+  display:inline-block;
+  min-width:22px;
+  text-align:right;
+  color:#dff8ff;
+}
+.question-timer-pill.warning{
+  border-color:rgba(255,208,86,.75)!important;
+  background:rgba(89,61,4,.44)!important;
+  box-shadow:0 0 16px rgba(255,205,70,.14);
+}
+.question-timer-pill.warning b{color:#ffe072}
+.question-timer-pill.danger{
+  border-color:rgba(255,72,101,.85)!important;
+  background:rgba(100,9,30,.58)!important;
+  animation:questionTimerPulse .72s ease-in-out infinite alternate;
+}
+.question-timer-pill.danger b{color:#ff8ca0}
+@keyframes questionTimerPulse{
+  from{transform:scale(1);box-shadow:0 0 0 rgba(255,67,103,0)}
+  to{transform:scale(1.035);box-shadow:0 0 18px rgba(255,67,103,.28)}
+}
+.timeout-flash{
+  animation:timeoutFlash .55s ease;
+}
+@keyframes timeoutFlash{
+  0%{box-shadow:0 0 0 rgba(255,56,88,0)}
+  35%{box-shadow:inset 0 0 0 9999px rgba(255,35,71,.10)}
+  100%{box-shadow:0 0 0 rgba(255,56,88,0)}
+}
+/* ===== end countdown v3 ===== */
+
